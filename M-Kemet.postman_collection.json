        {
          "name": "Register Candidate (الباحث عن عمل)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept-Language",
                "value": "ar",
                "description": "ar or en",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"أحمد عبد العزيز\",\n    \"email\": \"candidate@example.com\",\n    \"phone\": \"0501234567\",\n    \"password\": \"Password123#\",\n    \"password_confirmation\": \"Password123#\",\n    \"current_country_id\": 1,\n    \"birth_date\": \"1996-05-15\",\n    \"gender_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register/candidate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register",
                "candidate"
              ]
            },
            "description": "تسجيل حساب باحث عن عمل جديد بكل الحقول"
          },
          "response": []
        },
